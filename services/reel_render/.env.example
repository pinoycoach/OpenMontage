# Reel render service settings. Names only: on Cloud Run the keys come from Secret Manager,
# never from this file. Every line is commented out: uncomment only what you set. The default in
# brackets applies when the variable is missing, and an empty number stops the service from starting.

# Bearer token the app sends with every POST; requests are refused (503) while it's unset.
# RENDER_TOKEN=
# fal key for talking scenes, motion scenes and dub background separation; without it those are skipped.
# FAL_KEY=
# Estimated fal spend allowed per day (Manila time), in USD; past it fal isn't called. [no cap]
# FAL_DAILY_CAP_USD=

# Remotion render time limit in seconds. [840]
# RENDER_TIMEOUT_SECONDS=
# "whisper" times captions to the speech; anything else spreads words evenly. [whisper]
# CAPTION_SYNC=
# faster-whisper model for reel captions and clips. [base]
# WHISPER_MODEL=
# faster-whisper model for dub transcripts. [small]
# DUB_WHISPER_MODEL=

# fal model for talking scenes. [fal-ai/flashtalk]
# FAL_TALKING_MODEL=
# Seconds to wait for talking clips before keeping the images. [360]
# TALKING_TIMEOUT_SECONDS=
# fal model for motion scenes. [fal-ai/kling-video/v3/standard/image-to-video]
# FAL_MOTION_MODEL=
# Seconds to wait for motion clips before keeping the images. [420]
# MOTION_TIMEOUT_SECONDS=
# fal model that splits the dub soundtrack into stems. [fal-ai/demucs]
# FAL_STEMS_MODEL=
# Seconds to wait for the stems before dubbing without the background. [300]
# STEMS_TIMEOUT_SECONDS=

# Where Drive sources are cached (memory on Cloud Run). [/tmp/clip-sources]
# CLIP_CACHE=
# Cache size limit in MB; the oldest sources not in use are dropped to stay under it. [2500]
# CLIP_CACHE_MAX_MB=
# Largest Drive video accepted, in MB. [1500]
# MAX_SOURCE_MB=
# Longest Drive video accepted, in minutes. [90]
# MAX_SOURCE_MINUTES=
# Total time allowed for one Drive download, in seconds. [600]
# DRIVE_DOWNLOAD_DEADLINE_S=
